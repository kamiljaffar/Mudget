# Neon Postgres — alag "mudget" database (CareFlow ki neondb se isolated)
# pooled endpoint — app/Vercel isse query karta hai
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/mudget?sslmode=require"
# direct endpoint — prisma db push / migrate ke liye
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/mudget?sslmode=require"

# Session signing secret — long random hex, production mein zaroor badlein
JWT_SECRET="change-me-to-a-long-random-string"
